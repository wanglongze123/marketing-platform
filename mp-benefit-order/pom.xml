<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mp</groupId>
    <artifactId>marketing-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>mp-benefit-order</artifactId>
  <description>玩法：权益售卖</description>

  <!-- 依赖方向由此处强制，见《开发规范》§3.2：只声明允许方向的依赖 -->
  <dependencies>
    <!--
      web：V4 起本模块自带 L3 冲突计数端点（ContentionController）。
      ContentionMetrics 是进程内 LongAdder，计数发生在本模块的建单与库存扣减路径上，
      拆服务后 gateway 读不到它，故控制面随状态所在的进程走。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- 分页插件（PaginationInnerInterceptor），3.5.9 起独立成 artifact -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
    </dependency>
    <!-- L2 分布式锁。注意：锁只是性能优化，正确性由 L3 唯一索引兜底（技术方案 §6.1） -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-benefit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-activity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-reward</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-mock</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-activity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-reward</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-mock-downstream</artifactId>
    </dependency>
  </dependencies>
</project>
