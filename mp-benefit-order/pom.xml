<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mp</groupId>
    <artifactId>marketing-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>mp-benefit-order</artifactId>
  <description>玩法：权益售卖</description>

  <!-- 依赖方向由此处强制，见《开发规范》§3.2：只声明允许方向的依赖 -->
  <dependencies>
    <!--
      web：V4 起本模块自带 L3 冲突计数端点（ContentionController）。
      ContentionMetrics 是进程内 LongAdder，计数发生在本模块的建单与库存扣减路径上，
      拆服务后 gateway 读不到它，故控制面随状态所在的进程走。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- 分页插件（PaginationInnerInterceptor），3.5.9 起独立成 artifact -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
    </dependency>
    <!-- L2 分布式锁。注意：锁只是性能优化，正确性由 L3 唯一索引兜底（技术方案 §6.1） -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-benefit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-activity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-reward</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-mock</artifactId>
    </dependency>
    <!--
      V4 起不再依赖 mp-activity / mp-reward / mp-mock-downstream 的实现 jar，只留 api。

      留着的后果不是编译错误而是「拆了但没真拆」：实现类进了本服务的 fat jar，Dubbo
      发现同进程有 @DubboService 暴露的同接口实现，就会优先走本地 bean，跨服务 RPC
      根本不发生 —— Nacos 上看得到注册，调用却从未出网。

      代码层面本就没有跨模块 import（全走 com.mp.api.*），删掉零改动。单进程形态由
      mp-gateway 显式聚合这三个实现模块，不受影响。
    -->
  </dependencies>

  <!--
    可执行 jar。V4 起本模块可作为独立服务启动（见 BenefitOrderApplication），
    故需 repackage 产出 fat jar。单进程形态不受影响 —— 那时由 mp-gateway
    的 jar 承载全部模块，本 jar 只是不被用到。
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                classifier 不可省。默认 repackage 会把原 jar 替换成 fat jar，
                而 fat jar 里的类挪到了 BOOT-INF/classes/ 下 —— 依赖本模块的
                其他模块（mp-gateway 及其测试）随即 import 不到任何类。

                配上之后产出两个文件：mp-xxx.jar 仍是普通库 jar 供模块间依赖，
                mp-xxx-boot.jar 是可执行 fat jar 供容器启动。
              -->
              <classifier>boot</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
