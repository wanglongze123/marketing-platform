<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mp</groupId>
    <artifactId>marketing-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>mp-mock-downstream</artifactId>
  <description>mock 支付、mock 供应方</description>

  <!-- 依赖方向由此处强制，见《开发规范》§3.2：只声明允许方向的依赖 -->
  <dependencies>
    <!--
      web：V4 起本模块自带故障注入控制面（FaultInjectionController）。
      拆服务后 gateway 不再包含 mock 实现，控制面必须随状态所在的进程走 ——
      FaultInjector / PayLedger / ProviderLedger 都是进程内 ConcurrentHashMap，
      隔进程调用改不到它们。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-mock</artifactId>
    </dependency>
    <!--
      ApiResponse 与 TraceIdHolder。不引 mp-api-benefit / mp-api-reward ——
      签名端点的入参是玩法层与公共能力层的 DTO，本模块是最下层，引它们即依赖倒挂。
      故两个签名端点留在 gateway（它们只依赖 mp-common 的签名器）。
    -->
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-common</artifactId>
    </dependency>
  </dependencies>

  <!--
    可执行 jar。V4 起本模块可作为独立服务启动（见 MockDownstreamApplication），
    故需 repackage 产出 fat jar。单进程形态不受影响 —— 那时由 mp-gateway
    的 jar 承载全部模块，本 jar 只是不被用到。
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                classifier 不可省。默认 repackage 会把原 jar 替换成 fat jar，
                而 fat jar 里的类挪到了 BOOT-INF/classes/ 下 —— 依赖本模块的
                其他模块（mp-gateway 及其测试）随即 import 不到任何类。

                配上之后产出两个文件：mp-xxx.jar 仍是普通库 jar 供模块间依赖，
                mp-xxx-boot.jar 是可执行 fat jar 供容器启动。
              -->
              <classifier>boot</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
