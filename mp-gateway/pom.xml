<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mp</groupId>
    <artifactId>marketing-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>mp-gateway</artifactId>
  <description>接入层：鉴权、限流、路由、统一响应。V0/V1 为单进程启动入口</description>

  <!-- 依赖方向：接入层在最上层，可依赖全部下层 -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
    </dependency>
    <!--
      Nacos 注册中心客户端。仅分布式形态用到（registry.address=nacos://），
      injvm 形态下它在 classpath 上但不被加载。理由见根 pom 的同处注释。
    -->
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-registry-nacos</artifactId>
    </dependency>

    <!-- 玩法层 -->
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-benefit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-api-fission</artifactId>
    </dependency>

    <!--
      五个实现模块：单进程形态（GatewayApplication + 34 个集成测试）靠它们在同进程内
      提供 injvm 调用；分布式形态（GatewayDistApplication）则必须没有它们，否则
      @DubboService 会让 Dubbo 把本地实现注册成 bean —— 注入报「2 candidates」，
      就算侥幸选中远程那个，调用也在同进程闭环，跨服务 RPC 从不发生。

      区分靠 spring-boot-maven-plugin 的 excludes（见下方 build 段），不靠 optional：
      optional 依赖不向下传递，标了它 Redisson / MyBatis 这些 starter 就进不了
      gateway 的测试 classpath，34 个集成测试全报 No qualifying bean of type
      RedissonClient。excludes 只影响 fat jar 的组装，编译与测试不受影响。
    -->
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-benefit-order</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-fission</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-activity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-reward</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mp</groupId>
      <artifactId>mp-mock-downstream</artifactId>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!--
                与其余五个模块统一：产出 mp-gateway-*-boot.jar 供容器启动，
                原 jar 保持普通库形态。gateway 目前无人依赖，加 classifier
                只为让 docker/Dockerfile 有单一取 jar 规则 —— 六个服务一份
                Dockerfile，靠 *-boot.jar 通配，不必为 gateway 开特例。
              -->
              <classifier>boot</classifier>
              <!--
                fat jar 的入口取 GatewayDistApplication —— 本模块有两个启动类，
                不指定时 repackage 会因「找到多个 main」而失败。

                两个入口的分工：GatewayApplication 扫 com.mp，是单进程形态的
                装配入口，由 mvn spring-boot:run 使用；GatewayDistApplication
                只扫 com.mp.gateway，是拆服务后的接入层入口，容器用它。
              -->
              <mainClass>com.mp.gateway.dist.GatewayDistApplication</mainClass>
              <!--
                fat jar 排除五个实现模块。optional 只影响传递依赖，不影响本模块
                自己的打包 —— 实测标了 optional 后 BOOT-INF/lib 下它们照样在。

                排除的理由见上方依赖段的注释：留着会让 Dubbo 把本地实现注册成
                bean，注入报「2 candidates」，就算侥幸选中远程那个，调用也在
                同进程闭环，跨服务 RPC 从不发生。
              -->
              <excludes>
                <exclude>
                  <groupId>com.mp</groupId>
                  <artifactId>mp-benefit-order</artifactId>
                </exclude>
                <exclude>
                  <groupId>com.mp</groupId>
                  <artifactId>mp-fission</artifactId>
                </exclude>
                <exclude>
                  <groupId>com.mp</groupId>
                  <artifactId>mp-activity</artifactId>
                </exclude>
                <exclude>
                  <groupId>com.mp</groupId>
                  <artifactId>mp-reward</artifactId>
                </exclude>
                <exclude>
                  <groupId>com.mp</groupId>
                  <artifactId>mp-mock-downstream</artifactId>
                </exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
