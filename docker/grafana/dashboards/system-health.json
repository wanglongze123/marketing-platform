{
  "title": "系统健康",
  "uid": "mp-system-health",
  "tags": ["mp", "健康"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "服务在线",
      "description": "多副本场景下单个实例失联属正常（kill -9 验证时会看到）。",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(up{job=\"mp-services\"} == 1)" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "接口 QPS",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "P99 时延",
      "description": "目标：预咨询 ≤100ms、创建订单 ≤200ms、支付通知 ≤100ms（§8.3）。",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "5xx 错误率",
      "description": "目标 < 0.1%。4xxx 是业务拒绝，不计入 —— 它们是防线在工作。",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "数据库连接池",
      "description": "四池总上限 40，低于 MySQL 默认 max_connections=151。虚拟线程开启后连接池必须显式设定。",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{application}} / {{pool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC 停顿",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "{{application}} {{action}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
